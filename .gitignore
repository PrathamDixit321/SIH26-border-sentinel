# ==========================================
# Video formats (Exclude all video files)
# ==========================================
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.flv

# Specific video test recordings
Komal 1.mp4
Komal 2.mp4
Komal 3.mp4
Yash Raj 1.mp4
Yash Raj 2.mp4

# ==========================================
# Image / Picture formats (Exclude all pics)
# ==========================================
*.jpg
*.jpeg
*.png
*.webp
*.bmp
*.tiff
*.gif
*.ico
*.svg

# Exclude generated snapshot crops and visual preview directories
outputs/alerts/*.jpg
outputs/alerts/*.png
outputs/*.mp4
outputs/*.jpg
outputs/*.png

# Allow alerts.json to be tracked
!outputs/alerts.json

# ==========================================
# Model weights & training runs
# ==========================================
*.pt
*.onnx
*.engine
*.weights
runs/

# ==========================================
# Python cache & compiled files
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# ==========================================
# Virtual environments
# ==========================================
.venv/
venv/
ENV/
env/

# ==========================================
# IDE and OS files
# ==========================================
.vscode/
.idea/
.DS_Store
Thumbs.db

# Frontend build and dependencies
node_modules/
dashboard/node_modules/
dashboard/dist/
dist/

# Local database runtime
backend/sample_data/alerts_db.json

